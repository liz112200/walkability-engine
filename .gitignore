# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# ── Environments ──────────────────────────────────────────────────────────────
.env
.venv/
venv/
ENV/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Data — raw files are never committed to Git ───────────────────────────────
data/raw/
data/external/
# Use wildcard (not directory/) so negation exceptions below are honoured by git
data/processed/*
outputs/models/*

!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!outputs/models/.gitkeep
# Parquet files committed so both Railway and Streamlit Cloud can serve them
!data/processed/shap_values.parquet
!data/processed/master_features.parquet

# ── OSMnx tile cache ──────────────────────────────────────────────────────────
.osmnx_cache/

# ── MLflow ────────────────────────────────────────────────────────────────────
mlruns/
mlartifacts/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
*.env
secrets.yml
configs/secrets.yml
.streamlit/secrets.toml

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.logcache/
cache/
mlflow.db
mlruns/
outputs/
